# today-meal 환경 변수 예시
# 실제 키는 .env 파일에 (gitignore 등재됨)
# Vite에서 클라이언트 노출 변수는 VITE_ 접두사 필수
# 서버(Vercel Serverless) 키는 접두사 없음 → Vercel 대시보드 Project Settings → Environment Variables 에 추가

# === 쿠팡 파트너스 어필리에이트 (서버 전용 — Vercel 환경변수에만 추가) ===
# https://partners.coupang.com → 가입 + 채널 등록(Vercel 도메인) + 승인 후 발급
# 절대 클라이언트 코드에 노출 ❌
# COUPANG_ACCESS_KEY=
# COUPANG_SECRET_KEY=

# === v2.1 예정 ===

# 날씨 API (옵션, 위치 허용 시)
# VITE_WEATHER_API_KEY=

# === v2.2+ 예정 ===

# Buffer API (소셜 자동 게시)
# BUFFER_API_KEY=

# 추가 어필리에이트 트래킹 ID
# VITE_MARKETKURLY_PARTNER_ID=
