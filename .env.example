# today-meal 환경 변수 예시
# 실제 키는 .env 파일에 (gitignore 등재됨)
# Vite에서 클라이언트 노출 변수는 VITE_ 접두사 필수

# === v2.0 ===
# (현재 외부 API 사용 안 함 - 익명 로컬 우선)

# === v2.1 예정 ===

# 날씨 API (옵션, 위치 허용 시)
# VITE_WEATHER_API_KEY=

# === v2.2+ 예정 ===

# Buffer API (소셜 자동 게시)
# BUFFER_API_KEY=

# 어필리에이트 트래킹 ID
# VITE_COUPANG_PARTNER_ID=
# VITE_MARKETKURLY_PARTNER_ID=
